@model iLearning.Web.Models.ViewModels.Inventories.InventoryFieldsPageVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["Common.Fields"];
    var msg = TempData["InventoryMessage"] as string;
}

<div class="container py-4" style="max-width: 1000px;">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-0">@T["Common.Fields"]</h2>
            <div class="text-muted small">@Model.InventoryTitle</div>
        </div>

        <div class="d-flex align-items-center gap-3">
            <span class="text-muted small" id="autosaveStatus" data-prefix="@T["Inv.AutoSave.Label"]" data-off="@T["Inv.AutoSave.Off"]"
                  data-ready="@T["Inv.AutoSave.Ready"]" data-pending="@T["Inv.AutoSave.Pending"]" data-saving="@T["Inv.AutoSave.Saving"]"
                  data-saved="@T["Inv.AutoSave.Saved"]" data-error="@T["Inv.AutoSave.Error"]" data-conflict="@T["Inv.AutoSave.Conflict"]"
                  data-at="@T["Inv.AutoSave.At"]">
                @T["Inv.AutoSave.Label"] @T["Inv.AutoSave.Off"]
            </span>

            <a class="btn btn-outline-secondary"
               asp-controller="Inventories" asp-action="Details"
               asp-route-id="@Model.InventoryId" asp-route-tab="items">
                @T["Common.BackToInventory"]
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(msg))
    {
        <div class="alert alert-success mb-3">@msg</div>
    }

    <div class="card">
        <div class="card-body">
            <form method="post" asp-action="Save" asp-route-inventoryId="@Model.InventoryId" id="inventoryFieldsForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="InventoryId" />
                <input type="hidden" asp-for="Version" />

                <div class="text-muted small mb-3">
                    @T["InventoryFields.Help.EnableFields"]
                </div>

                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomString1Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.String1"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomString1Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                            <div class="form-text">@T["Common.IfEmptyDefaultLabelUsed"]</div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomString2Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.String2"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomString2Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomString3Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.String3"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomString3Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomText1Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Text1"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomText1Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomText2Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Text2"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomText2Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomText3Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Text3"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomText3Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomNumber1Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Number1"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomNumber1Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomNumber2Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Number2"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomNumber2Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomNumber3Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Number3"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomNumber3Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomBool1Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Bool1"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomBool1Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomBool2Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Bool2"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomBool2Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomBool3Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Bool3"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomBool3Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomLink1Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Link1"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomLink1Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomLink2Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Link2"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomLink2Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="CustomLink3Enabled" />
                                <label class="form-check-label">@T["InventoryFields.Label.Link3"]</label>
                            </div>
                            <input class="form-control" asp-for="CustomLink3Name" placeholder="@T["Common.CustomLabelOptional"]" maxlength="100" />
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary" type="submit">@T["InventoryFields.Actions.SaveFields"]</button>
                    <a class="btn btn-outline-secondary"
                       asp-controller="Inventories" asp-action="Details"
                       asp-route-id="@Model.InventoryId" asp-route-tab="items">
                        @T["Common.Cancel"]
                    </a>
                </div>

                <div class="form-text mt-3">
                    @T["InventoryFields.Help.AppliesImmediately"]
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/autosave-form.js" asp-append-version="true"></script>
    <script>
        InventoryAutoSave.init({
            formId: 'inventoryFieldsForm',
            statusElementId: 'autosaveStatus',
            url: '@Url.Action("InventoryFields", "AutoSave", new { id = Model.InventoryId })',
            idFieldName: 'InventoryId',
            versionFieldName: 'Version',
            delayMs: 800
        });
    </script>
}