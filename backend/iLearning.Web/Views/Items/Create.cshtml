@model iLearning.Web.Models.ViewModels.Items.ItemUpsertVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["Items.Create.PageTitle"].Value;
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 ">
        <h2 class="mb-0">@T["Items.Create.Heading"]</h2>

        <a class="btn btn-outline-secondary" asp-controller="Inventories" asp-action="Details" asp-route-id="@Model.InventoryId"
           asp-route-tab="items">@T["Items.Create.BackToItems"]</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post" asp-controller="Items" asp-action="Create" asp-route-inventoryId="@Model.InventoryId">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="InventoryId" />

                @if (ViewData["CustomIdRefreshMessage"] is string customIdRefreshMessage && !string.IsNullOrWhiteSpace(customIdRefreshMessage))
                    {
                        <div class="alert alert-info mb-2">@customIdRefreshMessage</div>
                    }

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <partial name="_UpsertForm" model="Model" />

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-primary" type="submit">@T["Common.Create"]</button>
                    <a class="btn btn-outline-primary" asp-controller="Inventories" asp-action="Details"
                       asp-route-id="@Model.InventoryId" asp-route-tab="items">@T["Common.Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        window.itemCustomIdSuggestUrl = '@Url.Action("SuggestCustomId", "Items", new {inventoryId = Model.InventoryId })';
    </script>
}

