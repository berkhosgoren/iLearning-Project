@model iLearning.Web.Models.ViewModels.Items.ItemUpsertVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["Items.Edit.PageTitle"].Value;
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h2 class="mb-0">@T["Items.Edit.Heading"]</h2>

        <a class="btn btn-outline-secondary" asp-controller="Items" asp-action="Details" asp-route-inventoryId="@Model.InventoryId" asp-route-itemId="@Model.ItemId">
            @T["Common.Back"]
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post" asp-controller="Items" asp-action="Edit" asp-route-inventoryId="@Model.InventoryId" asp-route-itemId="@Model.ItemId">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="InventoryId" />
                <input type="hidden" asp-for="ItemId" />
                <input type="hidden" asp-for="Version" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <partial name="_UpsertForm" model="Model" />

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-primary" type="submit">@T["Common.Save"]</button>

                    <a class="btn btn-outline-primary" asp-controller="Items" asp-action="Details" asp-route-inventoryId="@Model.InventoryId" asp-route-itemId="@Model.ItemId">
                        @T["Common.Cancel"]
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}