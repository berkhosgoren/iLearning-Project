@model iLearning.Web.Models.ViewModels.Items.ItemUpsertVm

@{
    string Label(string? custom, string fallback) => !string.IsNullOrWhiteSpace(custom) ? custom! : fallback;
}

<div class="row g-3">
    <div class="col-md-4">
        <label class="form-label">Custom ID</label>
        <input asp-for="CustomId" class="form-control" />
        <span asp-validation-for="CustomId" class="text-danger small"></span>
        <div class="form-text">Unique inside this inventory.</div>
    </div>

    <div class="col-md-8">
        <label class="form-label">Title</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <hr />
        <div class="text-muted small mb-2">
            Fields here follows the inventory "Fields" settings.
        </div>
    </div>

    @if (Model.Fields.String1Enabled)
    {
        <div class="cold col-md-4">
            <label class="form-label">@Label(Model.Fields.String1Name, "String 1")</label>
            <input asp-for="String1" class="form-control" />
            <span asp-validation-for="String1" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.String2Enabled)
    {
        <div class="cold col-md-4">
            <label class="form-label">@Label(Model.Fields.String2Name, "String 2")</label>
            <input asp-for="String2" class="form-control" />
            <span asp-validation-for="String2" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.String3Enabled)
    {
        <div class="cold col-md-4">
            <label class="form-label">@Label(Model.Fields.String3Name, "String 3")</label>
            <input asp-for="String3" class="form-control" />
            <span asp-validation-for="String3" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Text1Enabled)
    {
        <div class="cold col-md-4">
            <label class="form-label">@Label(Model.Fields.Text1Name, "Text 1")</label>
            <input asp-for="Text1" class="form-control" />
            <span asp-validation-for="Text1" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Text2Enabled)
    {
        <div class="cold col-md-4">
            <label class="form-label">@Label(Model.Fields.Text2Name, "Text 2")</label>
            <input asp-for="Text2" class="form-control" />
            <span asp-validation-for="Text2" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Text3Enabled)
    {
        <div class="cold col-md-4">
            <label class="form-label">@Label(Model.Fields.Text3Name, "Text 3")</label>
            <input asp-for="Text3" class="form-control" />
            <span asp-validation-for="Text3" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Number1Enabled)
    {
        <div class="cold col-md-4">
            <label class="form-label">@Label(Model.Fields.Number1Name, "Number 1")</label>
            <input asp-for="Number1" class="form-control" />
        </div>
    }
    @if (Model.Fields.Number2Enabled)
    {
        <div class="cold col-md-4">
            <label class="form-label">@Label(Model.Fields.Number2Name, "Number 2")</label>
            <input asp-for="Number2" class="form-control" />
        </div>
    }
    @if (Model.Fields.Number3Enabled)
    {
        <div class="cold col-md-4">
            <label class="form-label">@Label(Model.Fields.Number3Name, "Number 3")</label>
            <input asp-for="Number3" class="form-control" />
        </div>
    }
    @if (Model.Fields.Bool1Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Bool1Name, "Bool 1")</label>
            <select asp-for="Bool1" class="form-select">
                <option value="">(Empty)</option>
                <option value="true">True</option>
                <option value="false">False</option>
            </select>
        </div>
    }
    @if (Model.Fields.Bool2Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Bool2Name, "Bool 2")</label>
            <select asp-for="Bool2" class="form-select">
                <option value="">(Empty)</option>
                <option value="true">True</option>
                <option value="false">False</option>
            </select>
        </div>
    }
    @if (Model.Fields.Bool3Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Bool3Name, "Bool 3")</label>
            <select asp-for="Bool3" class="form-select">
                <option value="">(Empty)</option>
                <option value="true">True</option>
                <option value="false">False</option>
            </select>
        </div>
    }
    @if (Model.Fields.Link1Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Link1Name, "Link 1")</label>
            <input asp-for="Link1" class="form-control" />
            <span asp-validation-for="Link1" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Link2Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Link2Name, "Link 2")</label>
            <input asp-for="Link2" class="form-control" />
            <span asp-validation-for="Link2" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Link3Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Link3Name, "Link 3")</label>
            <input asp-for="Link3" class="form-control" />
            <span asp-validation-for="Link3" class="text-danger small"></span>
        </div>
    }
</div>