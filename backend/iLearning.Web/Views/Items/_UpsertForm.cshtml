@model iLearning.Web.Models.ViewModels.Items.ItemUpsertVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    string Label(string? custom, string fallbackKey) => !string.IsNullOrWhiteSpace(custom) ? custom! : T[fallbackKey].Value;

    var hasSuggestedCustomId = !string.IsNullOrWhiteSpace(Model.SuggestedCustomId);
    var isCreateLocked = Model.IsCreateMode && hasSuggestedCustomId;
    var showUseSuggestedButton = !Model.IsCreateMode && hasSuggestedCustomId;
}

<div class="row g-3">
    <div class="col-md-4">
        <label class="form-label">@T["Common.CustomId"]</label>

        <div class="d-flex gap-2">
            <input asp-for="CustomId" class="form-control" id="itemCustomIdInput" readonly="@isCreateLocked" />

            @if (showUseSuggestedButton)
            {
                <button type="button" class="btn btn-outline-primary flex-shrink-0" id="itemCustomIdUseBtn"
                        @(string.IsNullOrWhiteSpace(Model.SuggestedCustomId) ? "disabled" : "")>
                    @T["Items.Upsert.UseSuggested"]
                </button>
            }           
        </div>

        <span asp-validation-for="CustomId" class="text-danger small"></span>

        <div class="form-text">
            @T["Items.Upsert.CustomIdHelp"]

            @if (hasSuggestedCustomId)
            {
                <span class="ms-2 text-muted" id="itemCustomIdSuggestedText">
                    (@Model.SuggestedCustomId)
                </span>
            }           
        </div>
    </div>

    <div class="col-md-8">
        <label class="form-label">@T["Common.Title"]</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <hr />
        <div class="text-muted small mb-2">
            @T["Items.Upsert.FieldsInventoryHelp"]
        </div>
    </div>

    @if (Model.Fields.String1Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.String1Name, "Common.String1")</label>
            <input asp-for="String1" class="form-control" />
            <span asp-validation-for="String1" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.String2Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.String2Name, "Common.String2")</label>
            <input asp-for="String2" class="form-control" />
            <span asp-validation-for="String2" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.String3Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.String3Name, "Common.String3")</label>
            <input asp-for="String3" class="form-control" />
            <span asp-validation-for="String3" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Text1Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Text1Name, "Common.Text1")</label>
            <input asp-for="Text1" class="form-control" />
            <span asp-validation-for="Text1" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Text2Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Text2Name, "Common.Text2")</label>
            <input asp-for="Text2" class="form-control" />
            <span asp-validation-for="Text2" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Text3Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Text3Name, "Common.Text3")</label>
            <input asp-for="Text3" class="form-control" />
            <span asp-validation-for="Text3" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Number1Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Number1Name, "Common.Number1")</label>
            <input asp-for="Number1" class="form-control" />
        </div>
    }
    @if (Model.Fields.Number2Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Number2Name, "Common.Number2")</label>
            <input asp-for="Number2" class="form-control" />
        </div>
    }
    @if (Model.Fields.Number3Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Number3Name, "Common.Number3")</label>
            <input asp-for="Number3" class="form-control" />
        </div>
    }
    @if (Model.Fields.Bool1Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Bool1Name, "Common.Bool1")</label>
            <select asp-for="Bool1" class="form-select">
                <option value="">@T["Common.EmptyOption"]</option>
                <option value="true">@T["Common.True"]</option>
                <option value="false">@T["Common.False"]</option>
            </select>
        </div>
    }
    @if (Model.Fields.Bool2Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Bool2Name, "Common.Bool2")</label>
            <select asp-for="Bool2" class="form-select">
                <option value="">@T["Common.EmptyOption"]</option>
                <option value="true">@T["Common.True"]</option>
                <option value="false">@T["Common.False"]</option>
            </select>
        </div>
    }
    @if (Model.Fields.Bool3Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Bool3Name, "Common.Bool3")</label>
            <select asp-for="Bool3" class="form-select">
                <option value="">@T["Common.EmptyOption"]</option>
                <option value="true">@T["Common.True"]</option>
                <option value="false">@T["Common.False"]</option>
            </select>
        </div>
    }
    @if (Model.Fields.Link1Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Link1Name, "Common.Link1")</label>
            <input asp-for="Link1" class="form-control" />
            <span asp-validation-for="Link1" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Link2Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Link2Name, "Common.Link2")</label>
            <input asp-for="Link2" class="form-control" />
            <span asp-validation-for="Link2" class="text-danger small"></span>
        </div>
    }
    @if (Model.Fields.Link3Enabled)
    {
        <div class="col-md-4">
            <label class="form-label">@Label(Model.Fields.Link3Name, "Common.Link3")</label>
            <input asp-for="Link3" class="form-control" />
            <span asp-validation-for="Link3" class="text-danger small"></span>
        </div>
    }
</div>

@if (showUseSuggestedButton)
{
    <script>
        (function () {
            const input = document.getElementById('itemCustomIdInput');
            const suggestedText = document.getElementById('itemCustomIdSuggestedText');
            const useBtn = document.getElementById('itemCustomIdUseBtn');

            const url = window.itemCustomIdSuggestUrl;

            if (!input || !suggestedText || !useBtn) return;

            let lastSuggested = '@(Model.SuggestedCustomId ?? "")';

            function renderSuggested() {
                suggestedText.textContent = lastSuggested ? ('(' + lastSuggested + ')') : '';
                useBtn.disabled = !lastSuggested;
            }

            async function loadSuggested() {
                const url = window.itemCustomIdSuggestUrl;
                if (!url) { renderSuggested(); return; }

                try {
                    const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
                    if (!res.ok) { renderSuggested(); return; }

                    const data = await res.json();
                    if (data && data.suggested) {
                        lastSuggested = String(data.suggested);
                    }
            } catch {

            }

            renderSuggested();
            }

            useBtn.addEventListener('click', function () {
                if (lastSuggested) {
                    input.value = lastSuggested;
                    input.focus();
                }
            });

            renderSuggested();
            loadSuggested();
        })();
    </script>
}
