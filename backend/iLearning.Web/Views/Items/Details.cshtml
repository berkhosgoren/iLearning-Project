@model iLearning.Web.Models.ViewModels.Items.ItemDetailsVm

@{
    ViewData["Title"] = Model.CustomId;
    var msg = TempData["InventoryMessage"] as string;

    string Label(string? custom, string fallback) => !string.IsNullOrWhiteSpace(custom) ? custom! : fallback;
}

<div class="container py-4">
    @if (!string.IsNullOrWhiteSpace(msg))
    {
        <div class="alert alert-success mb-3">@msg</div>
    }

    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-1">@Model.CustomId</h2>
            <div class="text-muted">
                @Model.Title
            </div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-controller="Inventories" asp-action="Details" asp-route-id="@Model.InventoryId" asp-route-tab="items">
                Back
            </a>

            @if (Model.CanWrite)
            {
                <a class="btn btn-outline-primary" asp-controller="Items" asp-action="Edit" asp-route-inventoryId="@Model.InventoryId"
                   asp-route-itemId="@Model.ItemId">Edit Item</a>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Inventory</dt>
                <dd class="col-sm-9">@Model.InventoryTitle</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") by @Model.CreatedByName</dd>

                <dt class="col-sm-3">Updated</dt>
                <dd class="col-sm-9">
                    @if (Model.UpdatedAtUtc.HasValue)
                    {
                        @Model.UpdatedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        @if (!string.IsNullOrWhiteSpace(Model.UpdatedByName))
                        {
                            <span> by @Model.UpdatedByName</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </dd>

                <dt class="col-sm-3">Likes</dt>
                <dd class="col-sm-9">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="fw-semibold">@Model.LikesCount</span>

                        @if (Model.IsAuthenticated)
                        {
                            <form method="post"
                                  asp-controller="Items"
                                  asp-action="ToggleLike"
                                  asp-route-inventoryId="@Model.InventoryId"
                                  asp-route-itemId="@Model.ItemId"
                                  class="m-0">
                                @Html.AntiForgeryToken()

                                @if (Model.IsLikedByMe)
                                {
                                    <button class="btn btn-outline-secondary btn-sm" type="submit">Unlike</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-primary btn-sm" type="submit">Like</button>
                                }
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">Login to like</span>
                        }
                    </div>
                </dd>

                <dt class="col-sm-3">Comments</dt>
                <dd class="col-sm-9">@Model.CommentsCount</dd>
            </dl>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">Fields</div>
        <div class="card-body">
            <dl class="row mb-0">

                @if (Model.Fields.String1Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.String1Name, "String 1")</dt>
                    <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.String1) ? Model.String1 : "-")</dd>
                }
                @if (Model.Fields.String2Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.String2Name, "String 2")</dt>
                    <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.String2) ? Model.String2 : "-")</dd>
                }
                @if (Model.Fields.String3Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.String3Name, "String 3")</dt>
                    <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.String3) ? Model.String3 : "-")</dd>
                }
                @if (Model.Fields.Text1Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Text1Name, "Text 1")</dt>
                    <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Text1) ? Model.Text1 : "-")</dd>
                }
                @if (Model.Fields.Text2Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Text2Name, "Text 2")</dt>
                    <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Text2) ? Model.Text2 : "-")</dd>
                }
                @if (Model.Fields.Text3Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Text3Name, "Text 3")</dt>
                    <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Text3) ? Model.Text3 : "-")</dd>
                }
                @if (Model.Fields.Number1Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Number1Name, "Number 1")</dt>
                    <dd class="col-sm-9">@((Model.Number1.HasValue) ? Model.Number1.Value.ToString() : "-")</dd>
                }
                @if (Model.Fields.Number2Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Number2Name, "Number 2")</dt>
                    <dd class="col-sm-9">@((Model.Number2.HasValue) ? Model.Number2.Value.ToString() : "-")</dd>
                }
                @if (Model.Fields.Number3Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Number3Name, "Number 3")</dt>
                    <dd class="col-sm-9">@((Model.Number3.HasValue) ? Model.Number3.Value.ToString() : "-")</dd>
                }
                @if (Model.Fields.Bool1Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Bool1Name, "Bool 1")</dt>
                    <dd class="col-sm-9">@((Model.Bool1.HasValue) ? (Model.Bool1.Value ? "Yes" : "No") : "-")</dd>
                }
                @if (Model.Fields.Bool2Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Bool2Name, "Bool 2")</dt>
                    <dd class="col-sm-9">@((Model.Bool2.HasValue) ? (Model.Bool2.Value ? "Yes" : "No") : "-")</dd>
                }
                @if (Model.Fields.Bool3Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Bool3Name, "Bool 3")</dt>
                    <dd class="col-sm-9">@((Model.Bool3.HasValue) ? (Model.Bool3.Value ? "Yes" : "No") : "-")</dd>
                }
                @if (Model.Fields.Link1Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Link1Name, "Link 1")</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrWhiteSpace(Model.Link1))
                        {
                            <a href="@Model.Link1" target="_blank" rel="noopener noreferrer">@Model.Link1</a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>
                }
                @if (Model.Fields.Link2Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Link2Name, "Link 2")</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrWhiteSpace(Model.Link2))
                        {
                            <a href="@Model.Link2" target="_blank" rel="noopener noreferrer">@Model.Link2</a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>
                }
                @if (Model.Fields.Link3Enabled)
                {
                    <dt class="col-sm-3">@Label(Model.Fields.Link3Name, "Link 3")</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrWhiteSpace(Model.Link3))
                        {
                            <a href="@Model.Link3" target="_blank" rel="noopener noreferrer">@Model.Link3</a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>
                }
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">Comments</div>
        <div class="card-body">

            @if (Model.IsAuthenticated)
            {
                <form method="post"
                      asp-controller="Items"
                      asp-action="AddComment"
                      asp-route-inventoryId="@Model.InventoryId"
                      asp-route-itemId="@Model.ItemId"
                      class="mb-3">
                    @Html.AntiForgeryToken()

                    <div class="mb-2">
                        <textarea name="body" class="form-control" rows="3" maxlength="1000" placeholder="Write a comment..."></textarea>
                        <div class="form-text">Max 1000 characters.</div>
                    </div>

                    <button class="btn btn-primary btn-sm" type="submit">Post Comment</button>
                </form>
            }
            else
            {
                <div class="text-muted small mb-3">Login to post comments.</div>
            }

            @if (Model.Comments.Count == 0)
            {
                <div class="text-muted">No comments yet.</div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var c in Model.Comments)
                    {
                        <div class="border rounded p-3">
                            <div class="d-flex align-items-start justify-content-between gap-2">
                                <div>
                                    <div class="fw-semibold">@c.UserName</div>
                                    <div class="text-muted small">@c.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                </div>

                                @if (c.CanDelete)
                                {
                                    <form method="post"
                                          asp-controller="Items"
                                          asp-action="DeleteComment"
                                          asp-route-inventoryId="@Model.InventoryId"
                                          asp-route-itemId="@Model.ItemId"
                                          asp-route-commentId="@c.Id"
                                          class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                                    </form>
                                }
                            </div>

                            <div class="mt-2">@c.Body</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>