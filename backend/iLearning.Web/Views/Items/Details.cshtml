@model iLearning.Web.Models.ViewModels.Items.ItemDetailsVm

@{
    ViewData["Title"] = Model.CustomId;
}

<div class="container py-4">
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-1">@Model.CustomId</h2>
            <div class="text-muted">
                @Model.Title
            </div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-controller="Inventories" asp-action="Details" asp-route-id="@Model.InventoryId" asp-route-tab="items">
                Back
            </a>

            @if (Model.CanWrite)
            {
                <a class="btn btn-outline-primary" asp-controller="Items" asp-action="Edit" asp-route-inventoryId="@Model.InventoryId"
                   asp-route-itemId="@Model.ItemId">Edit Item</a>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Inventory</dt>
                <dd class="col-sm-9">@Model.InventoryTitle</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") by @Model.CreatedByName</dd>

                <dt class="col-sm-3">Updated</dt>
                <dd class="col-sm-9">
                    @if (Model.UpdatedAtUtc.HasValue)
                    {
                        @Model.UpdatedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        @if (!string.IsNullOrWhiteSpace(Model.UpdatedByName))
                        {
                            <span> by @Model.UpdatedByName</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </dd>

                <dt class="col-sm-3">Likes</dt>
                <dd class="col-sm-9">@Model.LikesCount</dd>

                <dt class="col-sm-3">Comments</dt>
                <dd class="col-sm-9">@Model.CommentsCount</dd>
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">Fields</div>
        <div class="card-body">
            <dl class="row mb-0">

                <dt class="col-sm-3">String1</dt>
                <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.String1) ? Model.String1 : "-")</dd>

                <dt class="col-sm-3">String2</dt>
                <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.String2) ? Model.String2 : "-")</dd>

                <dt class="col-sm-3">String3</dt>
                <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.String3) ? Model.String3 : "-")</dd>

                <dt class="col-sm-3">Text1</dt>
                <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Text1) ? Model.Text1 : "-")</dd>

                <dt class="col-sm-3">Text2</dt>
                <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Text2) ? Model.Text2 : "-")</dd>

                <dt class="col-sm-3">Text3</dt>
                <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Text3) ? Model.Text3 : "-")</dd>

                <dt class="col-sm-3">Number1</dt>
                <dd class="col-sm-9">@((Model.Number1.HasValue) ? Model.Number1.Value.ToString() : "*")</dd>

                <dt class="col-sm-3">Number2</dt>
                <dd class="col-sm-9">@((Model.Number2.HasValue) ? Model.Number2.Value.ToString() : "*")</dd>

                <dt class="col-sm-3">Number3</dt>
                <dd class="col-sm-9">@((Model.Number3.HasValue) ? Model.Number3.Value.ToString() : "*")</dd>

                <dt class="col-sm-3">Bool1</dt>
                <dd class="col-sm-9">@((Model.Bool1.HasValue) ? (Model.Bool1.Value ? "Yes" : "No") : "-")</dd>
                <dt class="col-sm-3">Bool2</dt>
                <dd class="col-sm-9">@((Model.Bool2.HasValue) ? (Model.Bool2.Value ? "Yes" : "No") : "-")</dd>
                <dt class="col-sm-3">Bool3</dt>
                <dd class="col-sm-9">@((Model.Bool3.HasValue) ? (Model.Bool3.Value ? "Yes" : "No") : "-")</dd>

                <dt class="col-sm-3">Link1</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.Link1))
                    {
                        <a href="@Model.Link1" target="_blank" rel="noopener noreferrer">@Model.Link1</a>
                    }
                    else { <span class="text-muted">-</span>}
                </dd>

                <dt class="col-sm-3">Link2</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.Link2))
                    {
                        <a href="@Model.Link2" target="_blank" rel="noopener noreferrer">@Model.Link2</a>
                    }
                    else
                    {

                        <span class="text-muted">-</span>
                    }
                </dd>

                <dt class="col-sm-3">Link3</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.Link3))
                    {
                        <a href="@Model.Link3" target="_blank" rel="noopener noreferrer">@Model.Link3</a>
                    }
                    else
                    {

                        <span class="text-muted">-</span>
                    }
                </dd>
            </dl>

            <div class="text-muted small mt-3">
                Fields labels will be replaced by inventory fields later.
            </div>
        </div>
    </div>
</div>