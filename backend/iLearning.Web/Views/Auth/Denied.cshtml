@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["Auth.Denied.Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="alert alert-warning">
                <h1 class="h5 mb-2">@T["Auth.Denied.Heading"]</h1>
                <p class="mb-0">
                    @T["Auth.Denied.Body"]
                </p>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">@T["Nav.Home"]</a>
                <a asp-action="Login" asp-controller="Auth" class="btn btn-primary">@T["Auth.Login.Title"]</a>
            </div>
        </div>
    </div>
</div>