@model iLearning.Web.Models.ViewModels.Auth.LoginVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["Auth.Login.Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">@T["Auth.Login.Title"]</h1>

                    @if (TempData["Message"] is string msg && !string.IsNullOrWhiteSpace(msg))
                    {
                        <div class="alert alert-info">@msg</div>
                    }

                    <form asp-action="Login" asp-controller="Auth" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">@T["Auth.Login.Button"]</button>
                    </form>

                    <div class="my-4 text-center text-muted small">@T["Auth.External.OrContinueWith"]</div>

                    <div class="d-grid gap-2">
                        <form asp-action="ExternalLogin" asp-controller="Auth" asp-route-provider="Google" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100">@T["Auth.External.Google"]</button>
                        </form>

                        <form asp-action="ExternalLogin" asp-controller="Auth" asp-route-provider="GitHub" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary w-100">@T["Auth.External.GitHub"]</button>
                        </form>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <p class="mt-3">
                            @T["Auth.Login.NoAccount"]
                            <a asp-action="Register">@T["Auth.Login.RegisterLink"]</a>
                        </p>
                        <a asp-action="Index" asp-controller="Home" class="link-secondary text-decoration-none">
                            @T["Auth.Login.BackHome"]
                        </a>
                    </div>
                </div>
            </div>

            <p class="text-center text-muted mt-3 mb-0 small">
                @T["Auth.Login.Footer"]
            </p>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}