@model iLearning.Web.Models.ViewModels.Account.AccountIndexVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["Account.Title"].Value;
    var msg = TempData["AccountMessage"] as string;

    var ownedPlaceholder = Model.IsAdmin ? T["Account.Filters.OwnedAdminPlaceholder"].Value : T["Account.Filters.OwnedPlaceholder"].Value;
    var selectedLabel = T["Common.SelectedLabel"].Value;
}

<div class="container py-4">
    
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h2 class="mb-0">@T["Account.Title"]</h2>

        <a class="btn btn-outline-primary" asp-controller="Salesforce" asp-action="Index">
            @T["Account.Actions.ExportToSalesforce"]
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(msg))
    {
        <div class="alert alert-success">@msg</div>
    }
    <!--Owned-->
    <div class="card mb-4">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="fw-semibold">
                @(Model.IsAdmin? T["Account.Sections.AllInventories"].Value : T["Account.Sections.InventoriesIOwn"].Value)
            </div>

            <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
                <input class="form-control form-control-sm" style="width: 260px"
                       name="oq" value="@Model.OwnedQuery" placeholder="@ownedPlaceholder" />

                 <select class="form-select form-select-sm" name="os" style="width: 160px">
                    <option value="created" selected="@(Model.OwnedSort == "created")">@T["Common.SortCreated"]</option>
                    <option value="title" selected="@(Model.OwnedSort == "title")">@T["Common.SortTitle"]</option>
                    <option value="category" selected="@(Model.OwnedSort == "category")">@T["Common.SortCategory"]</option>
                    <option value="public" selected="@(Model.OwnedSort == "public")">@T["Common.SortPublic"]</option>
                 </select>

                 <select class="form-select form-select-sm" name="od" style="width: 120px">
                    <option value="desc" selected="@(Model.OwnedDir == "desc")">@T["Common.Desc"]</option>
                    <option value="asc" selected="@(Model.OwnedDir == "asc")">@T["Common.Asc"]</option>
                 </select>

                 <input type="hidden" name="aq" value="@Model.AccessQuery" />
                 <input type="hidden" name="as" value="@Model.AccessSort" />
                 <input type="hidden" name="ad" value="@Model.AccessDir" />

                <button class="btn btn-outline-secondary btn-sm" type="submit">@T["Common.Apply"]</button>
            </form>
        </div>

        <div class="card-body">

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <div class="text-muted small" id="ownedSelectedLabel">@selectedLabel 0</div>

                <form method="post" asp-action="DeleteOwned" asp-controller="Account" id="ownedDeleteForm" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-danger btn-sm" type="submit" id="ownedDeleteBtn" disabled>
                        @T["Common.DeleteSelected"]
                    </button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table table-hover">
                        <tr>
                            <th style="width:44px;">
                                <input type="checkbox" id="ownedAll" aria-label="@T["Common.SelectAll"]" />
                            </th>
                            <th>@T["Common.Title"]</th>
                            
                            @if (Model.IsAdmin)
                            {
                                <th style="width:220px;">@T["Common.Owner"]</th>
                            }
                            <th style="width:180px;">@T["Common.Category"]</th>
                            <th style="width:120px;">@T["Common.Visibility"]</th>
                            <th style="width:170px;">@T["Common.Created"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Owned.Count == 0)
                        {
                            <tr>
                                <td colspan="@(Model.IsAdmin? 6 : 5)" class="text-muted text-center py-4">@T["Common.NoInventories"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var inv in Model.Owned)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="ownedRow" name="ids" form="ownedDeleteForm" value="@inv.Id" />
                                    </td>
                                    <td>
                                        <a asp-controller="Inventories" asp-action="Details" asp-route-id="@inv.Id" class="text-decoration-none">
                                            @inv.Title
                                        </a>
                                    </td>

                                    @if (Model.IsAdmin)
                                    {
                                        <td>@(!string.IsNullOrWhiteSpace(inv.OwnerName) ? inv.OwnerName : T["Common.Unknown"].Value)</td>
                                    }

                                    <td>@inv.CategoryName</td>
                                    <td>
                                        @if (inv.IsPublic)
                                        {
                                            <span class="badge text-bg-success">@T["Common.Public"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">@T["Common.Private"]</span>
                                        }
                                    </td>
                                    <td>@inv.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-muted small mt-2">
                @T["Account.Hints.OpenInventory"]
                @if (Model.IsAdmin)
                {
                    <span>@T["Account.Hints.AdminEditAny"]</span>
                }
            </div>
        </div>
    </div>
    <!--Write Access-->
    @if (!Model.IsAdmin)
    {
        <div class="card mb-4">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="fw-semibold">@T["Account.Sections.InventoriesICanEdit"]</div>

                <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
                    <input class="form-control form-control-sm" style="width: 260px"
                           name="aq" value="@Model.AccessQuery" placeholder="@T["Account.Filters.AccessPlaceholder"]" />

                    <select class="form-select form-select-sm" name="as" style="width: 160px">
                        <option value="created" selected="@(Model.AccessSort == "created")">@T["Common.SortCreated"]</option>
                        <option value="title" selected="@(Model.AccessSort == "title")">@T["Common.SortTitle"]</option>
                        <option value="category" selected="@(Model.AccessSort == "category")">@T["Common.SortCategory"]</option>
                        <option value="public" selected="@(Model.AccessSort == "public")">@T["Common.SortPublic"]</option>
                    </select>

                    <select class="form-select form-select-sm" name="ad" style="width: 120px">
                        <option value="desc" selected="@(Model.AccessDir == "desc")">@T["Common.Desc"]</option>
                        <option value="asc" selected="@(Model.AccessDir == "asc")">@T["Common.Asc"]</option>
                    </select>

                    <input type="hidden" name="oq" value="@Model.OwnedQuery" />
                    <input type="hidden" name="os" value="@Model.OwnedSort" />
                    <input type="hidden" name="od" value="@Model.OwnedDir" />

                    <button class="btn btn-outline-secondary btn-sm" type="submit">@T["Common.Apply"]</button>
                </form>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table table-hover">
                            <tr>
                                <th>@T["Common.Title"]</th>
                                <th style="width:220px;">@T["Common.Owner"]</th>
                                <th style="width:180px;">@T["Common.Category"]</th>
                                <th style="width:120px;">@T["Common.Visibility"]</th>
                                <th style="width:170px;">@T["Common.Created"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Access.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-muted text-center py-4">@T["Common.NoInventories"]</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var inv in Model.Access)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Inventories" asp-action="Details" asp-route-id="@inv.Id" class="text-decoration-none">
                                                @inv.Title
                                            </a>
                                        </td>
                                        <td>@inv.OwnerName</td>
                                        <td>@inv.CategoryName</td>
                                        <td>
                                            @if (inv.IsPublic)
                                            {
                                                <span class="badge text-bg-success">@T["Common.Public"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">@T["Common.Private"]</span>
                                            }
                                        </td>
                                        <td>@inv.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="text-muted small mt-2">
                    @T["Account.Hints.WriteAccessExplainer"]
                </div>
            </div>
        </div>

        <!--Read Only Access-->

        <div class="card">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="fw-semibold">@T["Account.Sections.ReadOnlyInventories"]</div>

                <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
                    <input class="form-control form-control-sm" style="width: 260px"
                           name="rq" value="@Model.ReadQuery" placeholder="@T["Common.Filter"]" />

                           <select class="form-select form-select-sm" name="rs" style="width: 160px">
                               <option value="created" selected="@(Model.ReadSort == "created")">@T["Common.SortCreated"]</option>
                               <option value="title" selected="@(Model.ReadSort == "title")">@T["Common.SortTitle"]</option>
                               <option value="category" selected="@(Model.ReadSort == "category")">@T["Common.SortCategory"]</option>
                           </select>

                           <select class="form-select form-select-sm" name="rd" style="width: 120px">
                               <option value="desc" selected="@(Model.ReadDir == "desc")">@T["Common.Desc"]</option>
                               <option value="asc" selected="@(Model.ReadDir == "asc")">@T["Common.Asc"]</option>
                           </select>

                           <input type="hidden" name="oq" value="@Model.OwnedQuery" />
                           <input type="hidden" name="os" value="@Model.OwnedSort" />
                           <input type="hidden" name="od" value="@Model.OwnedDir" />

                           <input type="hidden" name="aq" value="@Model.AccessQuery" />
                           <input type="hidden" name="as" value="@Model.AccessSort" />
                           <input type="hidden" name="ad" value="@Model.AccessDir" />

                           <button class="btn btn-outline-secondary btn-sm" type="submit">@T["Common.Apply"]</button>
                </form>
            </div>
            
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table table-hover">
                            <tr>
                                <th>@T["Common.Title"]</th>
                                <th style="width:220px;">@T["Common.Owner"]</th>
                                <th style="width:180px;">@T["Common.Category"]</th>
                                <th style="width:120px;">@T["Common.Visibility"]</th>
                                <th style="width:170px;">@T["Common.Created"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ReadOnly.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-muted text-center py-4">@T["Common.NoInventories"]</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var inv in Model.ReadOnly)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Inventories" asp-action="Details" asp-route-id="@inv.Id" class="text-decoration-none">
                                                @inv.Title
                                            </a>
                                        </td>
                                        <td>@inv.OwnerName</td>
                                        <td>@inv.CategoryName</td>
                                        <td>
                                            @if (inv.IsPublic)
                                            {
                                                <span class="badge text-bg-success">@T["Common.Public"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">@T["Common.Private"]</span>
                                            }
                                        </td>
                                        <td>@inv.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="text-muted small mt-2">
                    @T["Account.Hints.ReadOnlyExplainer"]
                </div>
            </div>

        </div>
    }
   
</div>

@section Scripts{
    @using System.Text.Json

    <script>
        (function () {
            const all = document.getElementById('ownedAll');
            const rows = () => Array.from(document.querySelectorAll('.ownedRow'));
            const label = document.getElementById('ownedSelectedLabel');
            const delBtn = document.getElementById('ownedDeleteBtn');

            const selectedLabel = @Html.Raw(JsonSerializer.Serialize(T["Common.SelectedLabel"].Value));

            function update(){
                const checked = rows().filter(x => x.checked).length;
                label.textContent = `${selectedLabel} ${checked}`;
                delBtn.disabled = checked === 0;

                if (!all) return;

                const total = rows().length;
                if (total === 0){
                    all.checked = false;
                    all.indeterminate = false;
                    return;
                }

                if (checked === 0){
                    all.checked = false;
                    all.indeterminate = false;
                } else if (checked === total){
                    all.checked = true;
                    all.indeterminate = false;
                } else{
                    all.checked = false;
                    all.indeterminate = true;
                }
            }

            if (all) {
                all.addEventListener('change', function(){
                    rows().forEach(x => x.checked = all.checked);
                    update();
                });
            }

            document.addEventListener('change', function (e){
                if (e.target && e.target.classList && e.target.classList.contains('ownedRow')){
                    update();
                }
            });

        update();
     })();
</script>
}