@model iLearning.Web.Models.ViewModels.Inventories.InventoryDetailsVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    var msg = TempData["InventoryMessage"] as string;
    var currentSort = (ViewBag.AccessSort as string ?? "name").ToLowerInvariant();
    var currentDir = (ViewBag.AccessDir as string ?? "asc").ToLowerInvariant();

    var selectedPrefixJson = System.Text.Json.JsonSerializer.Serialize(T["Common.SelectedPrefix"].Value);
    var noMatchesJson = System.Text.Json.JsonSerializer.Serialize(T["Common.NoMatches"].Value);
}

@if (!string.IsNullOrWhiteSpace(msg))
{
    <div class="alert alert-success mb-3">@msg</div>
}

@if (!Model.CanEdit)
{
    <div class="text-muted">@T["Inv.Access.NoPermission"]</div>
    return;
}

<div class="card mb-3">
    <div class="card-body">
        <form method="post" asp-controller="Inventories" asp-action="AccessAdd" asp-route-id="@Model.Id" class="row g-2 align-items-start">
            @Html.AntiForgeryToken()

            <div class="col-md-6 position-relative">
                <label class="form-label">@T["Inv.Access.AddUserLabel"]</label>

                <input class="form-control" id="accessUserQuery" autocomplete="off" placeholder="@T["Inv.Access.AddUserPlaceholder"]" />

                <input type="hidden" name="userId" id="accessUserId" />

                <div class="list-group position-absolute w-100 shadow-sm" id="accessUserSuggest" style="z-index: 1000; display:none;
                     max-height: 260px; overflow:auto;">
                </div>
                
            </div> 

            <div class="col-md-3">
                <label class="form-label">@T["Inv.Access.PermissionLabel"]</label>
                <select class="form-select" name="canWrite">
                    <option value="true" selected>@T["Inv.Access.Permission.CanWrite"]</option>
                    <option value="false">@T["Inv.Access.Permission.ReadOnly"]</option>
                </select>
            </div>

            <div class="col-md-3 d-flex flex-column">
                <label class="form-label invisible">@T["Inv.Access.ActionLabel"]</label>
                <button class="btn btn-primary w-100" type="submit" id="accessAddBtn" disabled>@T["Inv.Access.AddOrUpdate"]</button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
    <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
        <span>@T["Inv.Access.RowsLabel"]: @Model.AccessUsers.Count</span>
        <span id="accessSelectedLabel">@T["Common.SelectedCount", 0]</span>
    </div>

    <form method="get" asp-controller="Inventories" asp-action="Details" asp-route-id="@Model.Id" class="d-flex flex-wrap gap-2 align-items-end">
        <input type="hidden" name="tab" value="access" />

        <span class="text-muted small fw-semibold">@T["Common.Sort"]</span>

        <select class="form-select form-select-sm" name="accessSort" onchange="this.form.submit()">
            <option value="name" selected="@(currentSort == "name")">@T["Common.Name"]</option>
            <option value="email" selected="@(currentSort == "email")">@T["Common.Email"]</option>
            <option value="write" selected="@(currentSort == "write")">@T["Inv.Access.Table.Write"]</option>
            <option value="granted" selected="@(currentSort == "granted")">@T["Inv.Access.Table.Granted"]</option>
        </select>
        
        <select class="form-select form-select-sm" name="accessDir" onchange="this.form.submit()">
            <option value="asc" selected="@(currentDir == "asc")">@T["Common.Ascending"]</option>
            <option value="desc" selected="@(currentDir == "desc")">@T["Common.Descending"]</option>
        </select>
        <noscript>
            <button type="submit" class="btn btn-outline-secondary btn-sm">@T["Common.Apply"]</button>
        </noscript>
    </form>
</div>

    <div class="d-flex flex-wrap gap-2">
        <form method="post" asp-controller="Inventories" asp-action="AccessSetWrite" asp-route-id="@Model.Id" id="accessWriteForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="canWrite" value="true" />
            <button class="btn btn-outline-primary btn-sm" type="submit" id="accessWriteBtn" disabled>
                @T["Inv.Access.Bulk.GrantWrite"]
            </button>
        </form>

        <form method="post" asp-controller="Inventories" asp-action="AccessSetWrite" asp-route-id="@Model.Id" id="accessReadForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="canWrite" value="false" />
            <button class="btn btn-outline-secondary btn-sm" type="submit" id="accessReadBtn" disabled>
                @T["Inv.Access.Bulk.SetReadOnly"]
            </button>
        </form>

        <form method="post" asp-controller="Inventories" asp-action="AccessRemove" asp-route-id="@Model.Id" id="accessRemoveForm">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger btn-sm" type="submit" id="accessRemoveBtn" disabled>
                @T["Inv.Access.Bulk.RemoveSelected"]
            </button>
        </form>
    </div>
</div>


<div class="table-responsive">
    <table class="table table-sm align-middle mb-0">
        <thead class="table table-hover">
            <tr>
                <th style="width:44px;" class="text-cented align-middle p-0">
                    <input type="checkbox" id="accessAll" class="form-check-input d-block mx-auto my-2" aria-label="@T["Common.SelectAllAria"]" />
                </th>
                <th>@T["Common.Name"]</th>
                <th style="width:280px;">@T["Common.Email"]</th>
                <th style="width:140px;">@T["Inv.Access.Table.Write"]</th>
                <th style="width:180px;">@T["Inv.Access.Table.Granted"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.AccessUsers.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-muted text-center py-4">@T["Inv.Access.Empty"]</td>
                </tr>
            }
            else
            {
                foreach (var a in Model.AccessUsers)
                {
                    <tr>
                        <td class="text-center align-middle p-0">
                            <input type="checkbox" class="form-check-input d-block mx-auto my-2 accessRow" value="@a.UserId" />
                        </td>
                        <td>@a.Name</td>
                        <td>@a.Email</td>
                        <td>
                            @if (a.CanWrite)
                            {
                                <span class="badge text-bg-primary">@T["Common.Yes"]</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">@T["Common.No"]</span>
                            }
                        </td>
                        <td>@a.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="text-muted small mt-2">
    @T["Inv.Access.HelpText"]
</div>

<script>
    (function () {
        const all = document.getElementById('accessAll');
        const label = document.getElementById('accessSelectedLabel');

        const writeBtn = document.getElementById('accessWriteBtn');
        const readBtn = document.getElementById('accessReadBtn');
        const removeBtn = document.getElementById('accessRemoveBtn');

        const writeForm = document.getElementById('accessWriteForm');
        const readForm = document.getElementById('accessReadForm');
        const removeForm = document.getElementById('accessRemoveForm');

        const rows = () => Array.from(document.querySelectorAll('input.accessRow'));

        const selectedTextPrefix = @Html.Raw(selectedPrefixJson);
        const noMatchesText = @Html.Raw(noMatchesJson);

        function clearHidden(form) {
            Array.from(form.querySelectorAll('input[type="hidden"][name="ids"]')).forEach(x => x.remove());
        }
        
        function setHidden(form, ids) {
            clearHidden(form);
            ids.forEach(id => {
                const inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'ids';
                inp.value = id;
                form.appendChild(inp);
            });
        }
        function updateBulk() {
            const rowCbs = rows();
            const checkedIds = rowCbs.filter(x => x.checked).map(x => x.value);
            const checkedCount = checkedIds.length;

            if (label) label.textContent = selectedTextPrefix + checkedCount;

            const enable = checkedCount > 0;
            if (writeBtn) writeBtn.disabled = !enable;
            if (readBtn) readBtn.disabled = !enable;
            if (removeBtn) removeBtn.disabled = !enable;

            if (writeForm) setHidden(writeForm, checkedIds);
            if (readForm) setHidden(readForm, checkedIds);
            if (removeForm) setHidden(removeForm, checkedIds);

            if (!all) return;
            
            const totalCount = rowCbs.length;
            if (totalCount === 0) {
                all.checked = false;
                all.indeterminate = false;
                return;
            }

            if (checkedCount === 0) {
                all.checked = false;
                all.indeterminate = false;
            } else if (checkedCount === totalCount) {
                all.checked = true;
                all.indeterminate = false;
            } else {
                all.checked = false;
                all.indeterminate = true;
            }
        }

        const invId = '@Model.Id';

        const input = document.getElementById('accessUserQuery');
        const hiddenId = document.getElementById('accessUserId');
        const suggestBox = document.getElementById('accessUserSuggest');
        const addBtn = document.getElementById('accessAddBtn');

        let timer = null;
        let lastQuery = '';

        function escapeHtml(s) {
            return (s ?? '').toString()
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll('"', '&#039;');
            
        }

        function showSuggest() {
            if (suggestBox) suggestBox.style.display = '';
        }

        function hideSuggest() {
            if (!suggestBox) return;
            suggestBox.style.display = 'none';
            suggestBox.innerHTML = '';
        }

        function setPicked(user) {
            if (!hiddenId || !input || !addBtn) return;

            hiddenId.value = user.id;
            input.value = user.name + ' (' + user.email + ') ';
            addBtn.disabled = false;
            hideSuggest();
        }

        function clearPicked() {
            if (!hiddenId || !addBtn) return;

            hiddenId.value = '';
            addBtn.disabled = true;
        }

        async function fetchSuggest(q) {
            const url = '/inventories/' + invId + '/access/suggest?q=' + encodeURIComponent(q);
            const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
            if (!res.ok) return [];
            return await res.json();
        }

        function renderSuggest(list) {
            if (!suggestBox) return;

            suggestBox.innerHTML = '';

            if (!list || list.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'list-group-item text-muted';
                empty.textContent = noMatchesText;
                suggestBox.appendChild(empty);
                showSuggest();
                return;
            }

            list.forEach(u => {
                const a = document.createElement('button');
                a.type= 'button';
                a.className = 'list-group-item list-group-item-action';
                a.innerHTML =
                    '<div class="fw-semibold">' + escapeHtml(u.name) + '</div>' +
                    '<div class="text-muted small">' + escapeHtml(u.email) + '</div>';
                a.addEventListener('click', () => setPicked(u));
                suggestBox.appendChild(a);
            });

            showSuggest();
        }

        function updateSuggestState() {
            if (!addBtn || !hiddenId) return;
            addBtn.disabled = !hiddenId.value;
        }
        
        if (all) {
            all.addEventListener('change', function () {
            rows().forEach(x => x.checked = all.checked);
            updateBulk();
            });
        }
        
        document.addEventListener('change', function(e) {
            if (e.target && e.target.matches('input.accessRow')) {
                updateBulk();
            }
        });

        if (input && hiddenId && suggestBox && addBtn) {
            input.addEventListener('input', function() {
                const q = (input.value || '').trim();

                clearPicked();
                updateSuggestState();

                if (q.length < 2) {
                    hideSuggest();
                    return;
                }

                if (timer) clearTimeout(timer);
                timer = setTimeout(async () => {
                    if (q === lastQuery) return;
                    lastQuery = q;

                    const list = await fetchSuggest(q);
                    renderSuggest(list);
                }, 200);
            });

            document.addEventListener('click', function(e) {
                if (!suggestBox.contains(e.target) && e.target !== input) {
                    hideSuggest();
                }
            });

            input.addEventListener('focus', function () {
                const q = (input.value || '').trim();
                if (q.length >= 2 && suggestBox.innerHTML.trim() !== '') showSuggest();
            });

            const form = addBtn.closest('form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    if (!hiddenId.value) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                });
            }
        }

        updateBulk();
        updateSuggestState();
   })();
</script>