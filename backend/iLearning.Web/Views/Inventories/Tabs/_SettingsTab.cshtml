@model iLearning.Web.Models.ViewModels.Inventories.InventoryDetailsVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@if (Model.SettingsVm == null)
{
    <div class="text-muted">@T["InvTabs.UnknownTab"]</div>
}
else
{
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div class="fw-semibold">@T["InvTabs.Settings"]</div>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Inventories" asp-action="Details"
           asp-route-id="@Model.Id" asp-route-tab="items">@T["Common.Back"]</a>
    </div>

    <form method="post" asp-controller="Inventories" asp-action="Edit" asp-route-id="@Model.Id"
          id="inventorySettingsForm" data-autosave="true">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="SettingsVm.Id" />
        <input type="hidden" asp-for="SettingsVm.Version" />

        <partial name="~/Views/Inventories/_UpsertForm.cshtml" model="Model.SettingsVm" />

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">@T["Inv.Edit.Save"]</button>

            <a class="btn btn-outline-secondary" asp-controller="Inventories" asp-action="Details"
               asp-route-id="@Model.Id" asp-route-tab="items">@T["Inv.Edit.Cancel"]</a>
        </div>

        <div class="form-text mt-3">
            @T["Inv.Edit.Concurrency"]
        </div>
    </form>

    <script>
        (function () {
            const form = document.getElementById('inventorySettingsForm');
            if (!form) return;

            const statusEl = document.getElementById('autosaveStatus');

            const autosaveUrl = '@Url.Action("AutoSave", "Inventories", new { id = Model.Id })';

            function setStatus(stateKey, suffix = '') {
                if (!statusEl) return;

                const prefix = statusEl.dataset.prefix || 'Auto-save:';
                const value = statusEl.dataset[stateKey] || stateKey;

                statusEl.textContent = suffix
                    ? (prefix + ' ' + value + ' ' + suffix)
                    : (prefix + ' ' + value);
            }

            function formatNow() {
                const now = new Date();
                const atText = statusEl?.dataset.at || 'at';
                const time = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                return atText + ' ' + time;
            }

            function buildPayloadKey(fd) {
                return Array.from(fd.entries())
                    .filter(([k]) => k !== '__RequestVerificationToken')
                    .map(([k, v]) => k + '=' + String(v))
                    .join('&');
            }

            const tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenEl ? tokenEl.value : null;

            const idEl = form.querySelector('input[name="SettingsVm.Id"]');
            const versionEl = form.querySelector('input[name="SettingsVm.Version"]');

            if (!token || !idEl || !versionEl) {
                setStatus('off');
                return;
            }

            let timer = null;
            let isSaving = false;
            let hasPending = false;
            let lastPayload = '';
            let stoppedByConflict = false;

            function serializeForm() {
                const fd = new FormData(form);

                fd.set('Id', fd.get('SettingsVm.Id'));
                fd.set('Version', fd.get('SettingsVm.Version'));

                fd.delete('SettingsVm.Id');
                fd.delete('SettingsVm.Version');

                return fd;
            }

            async function doSave() {
                if (stoppedByConflict) return;

                const fd = serializeForm();
                const payloadKey = buildPayloadKey(fd);
                
                if (payloadKey === lastPayload) {
                    setStatus('saved', formatNow());
                    return;
                }

                if (isSaving) {
                    hasPending = true;
                    return;
                }

                isSaving = true;
                setStatus('saving');

                try {
                    const res = await fetch(autosaveUrl, {
                        method: 'POST',
                        body: fd,
                        headers: token ? { 'RequestVerificationToken': token } : {}
                    });

                    if (res.status === 409) {
                        stoppedByConflict = true;
                        setStatus('conflict');
                        return;
                    }

                    if (!res.ok) {
                        setStatus('error');
                        return;
                    }

                    const data = await res.json();

                    if (data && data.newVersion) {
                        const newVer = String(data.newVersion);
                        const settingsVersionEl = form.querySelector('input[name="SettingsVm.Version"]');
                        if (settingsVersionEl) settingsVersionEl.value = newVer;
                    }

                    lastPayload = buildPayloadKey(serializeForm());
                    setStatus('saved', formatNow());
                } catch {
                    setStatus('error');
                } finally {
                    isSaving = false;

                    if (hasPending) {
                        hasPending = false;
                        setTimeout(doSave, 50);
                    }
                }
            }
        
        function scheduleSave() {
            if (stoppedByConflict) return;

            setStatus('pending');

            if (timer) clearTimeout(timer);

            timer = setTimeout(doSave, 800);
        }

        form.addEventListener('input', function (e) {
            const el = e.target;
            if (!el) return;

            if (el.matches('input, textarea, select')) {
                scheduleSave();
            }
        });

        form.addEventListener('change', function(e) {
            const el = e.target;
            if (!el) return;

            if (el.matches('input[type="checkbox"], input[type="radio"], select')){
                scheduleSave();
            }                   
        });

        setStatus('ready');
    })();
    </script>
}