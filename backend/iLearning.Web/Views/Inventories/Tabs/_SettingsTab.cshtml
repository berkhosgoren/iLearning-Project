@model iLearning.Web.Models.ViewModels.Inventories.InventoryDetailsVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    var msg = TempData["InventoryMessage"] as string;
}

@if (Model.SettingsVm == null)
{
    <div class="text-muted">@T["InvTabs.UnknownTab"]</div>
}
else
{

    if (!string.IsNullOrWhiteSpace(msg))
    {
        <div class="alert alert-success mb-3">@msg</div>
    }

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div class="fw-semibold">@T["InvTabs.Settings"]</div>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Inventories" asp-action="Details"
           asp-route-id="@Model.Id" asp-route-tab="items">@T["Common.Back"]</a>
    </div>

    <form method="post" asp-controller="Inventories" asp-action="Edit" asp-route-id="@Model.Id"
          id="inventorySettingsForm" data-autosave="true" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" name="Id" value="@Model.SettingsVm.Id" />
        <input type="hidden" name="Version" value="@Model.SettingsVm.Version" />

        <partial name="~/Views/Inventories/_UpsertForm.cshtml" model="Model.SettingsVm" />

        <div class="form-text mb-3">
            @T["Inv.Form.ImageUploadSaveOnlyHint"]
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary" data-autosave-ignore="true">@T["Inv.Edit.Save"]</button>

            <a class="btn btn-outline-secondary" asp-controller="Inventories" asp-action="Details"
               asp-route-id="@Model.Id" asp-route-tab="items">@T["Inv.Edit.Cancel"]</a>
        </div>

        <div class="form-text mt-3">
            @T["Inv.Edit.Concurrency"]
        </div>
    </form>

    <script src="~/js/autosave-form.js" asp-append-version="true"></script>
    <script>
        InventoryAutoSave.init({
            formId: 'inventorySettingsForm',
            statusElementId: 'autosaveStatus',
            url: '@Url.Action("InventorySettings", "AutoSave", new { id = Model.Id })',
            idFieldName: 'Id',
            versionFieldName: 'Version',
            delayMs: 800,
        });
    </script>   
}