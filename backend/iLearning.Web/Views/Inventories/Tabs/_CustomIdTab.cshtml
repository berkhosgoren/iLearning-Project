@model iLearning.Web.Models.ViewModels.Inventories.InventoryDetailsVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    var vm = Model.CustomIdVm;
}

@if (vm == null)
{
    <div class="text-muted">@T["Inv.CustomId.NotAvailable"]</div>
}
else
{
    <div class="row g-3" style="max-width: 900px;">
        <div class="col-12">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <div class="fw-semibold">@T["Inv.CustomId.Title"]</div>
                    <div class="text-muted small mt-1">@T["Inv.CustomId.Help"]</div>

                    <div class="form-check mt-3 mb-3">
                        <input class="form-check-input" type="checkbox" id="cidEnabled" name="Enabled" value="true" @(vm.Enabled ? "checked" : null) />
                        <input type="hidden" name="Enabled" value="false" />
                        <label class="form-check-label" for="cidEnabled">
                            @T["Inv.CustomId.Enabled"]
                        </label>
                        <div class="form-text">
                            @T["Inv.CustomId.EnabledHelp"]
                        </div>
                    </div>         
                </div>
            </div>
        </div>

        <div class="col-12">
            <form method="post" asp-controller="Inventories" asp-action="SaveCustomId" asp-route-id="@Model.Id" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <input type="hidden" name="InventoryId" value="@vm.InventoryId" />
                <input type="hidden" name="Version" value="@vm.Version" />

                <div class="card">
                    <div class="card-body">

                    <div id="cidSettingsWrap">
                        <div class="mb-3">
                            <label class="form-label">@T["Inv.CustomId.Prefix"]</label>
                            <input class="form-control" id="cidPrefix" name="Prefix" value="@(vm.Prefix ?? "")"
                                   maxlength="20" placeholder="@T["Inv.CustomId.PrefixPlaceholder"]" />
                            <div class="form-text">@T["Inv.CustomId.PrefixHelp"]</div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">@T["Inv.CustomId.Digits"]</label>
                                <input class="form-control" id="cidDigits" name="Digits" type="number"
                                       min="1" max="8" step="1" value="@vm.Digits" />
                                <div class="form-text">@T["Inv.CustomId.DigitsHelp"]</div>
                                <div class="invalid-feedback">
                                    @T["Inv.CustomId.DigitsRange"]
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">@T["Inv.CustomId.NextNumber"]</label>
                                <input class="form-control" id="cidNext" name="NextNumber" min="1" step="1" value="@vm.NextNumber" />
                                <div class="form-text">@T["Inv.CustomId.NextHelp"]</div>
                                <div class="invalid-feedback">
                                    @T["Inv.CustomId.NextError"]
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">@T["Inv.CustomId.Preview"]</label>
                                <input class="form-control" id="cidPreview" value="@vm.Preview" readonly />
                                <div class="form-text">@T["Inv.CustomId.PreviewHelp"]</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button class="btn btn-primary" type="submit">@T["Common.Save"]</button>
                        <a class="btn btn-outline-secondary" asp-controller="Inventories" asp-action="Details"
                           asp-route-id="@Model.Id" asp-route-tab="customid">@T["Common.Cancel"]</a>
                       </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script>
        (function () {

            const form = document.querySelector('form.needs-validation');
            if (!form) return;

            const enabledEl = document.getElementById('cidEnabled');
            const wrapEl = document.getElementById('cidSettingsWrap');
            const prefixEl = document.getElementById('cidPrefix');
            const digitsEl = document.getElementById('cidDigits');
            const nextEl = document.getElementById('cidNext');
            const previewEl = document.getElementById('cidPreview');

            function padLeft(value, digits) {
                value = String(value || '');
                while (value.length < digits) value = '0' + value;
                return value;
            }

            function isEnabled() {
                return enabledEl && enabledEl.checked;
            }

            function setInnerDisabled(disabled) {
                [prefixEl, digitsEl, nextEl, previewEl].forEach(el => {
                    if (el) el.disabled = disabled;
                });

                if (wrapEl) {
                    wrapEl.style.opacity = disabled ? `0.6` : `1`;
                    wrapEl.style.pointerEvents = disabled ? `none` : `auto`;
                }
            }

            function validateDigits() {
                if (!isEnabled()) {
                    digitsEl.classList.remove('is-invalid');
                    digitsEl.setCustomValidity('');
                    return 4;
                }
                    
                const digits = parseInt(digitsEl.value || '4', 10);
                const invalid = Number.isNaN(digits) || digits < 1 || digits > 8;
                
                if (invalid) {
                    digitsEl.classList.add('is-invalid');
                    digitsEl.setCustomValidity('invalid');
                    return null;
                }

                digitsEl.classList.remove('is-invalid');
                digitsEl.setCustomValidity('');

                return digits;
            }

            function validateNext() {
                if(!isEnabled()) {
                    nextEl.classList.remove('is-invalid');
                    nextEl.setCustomValidity('');
                    return 1;
                }
                
                const next = parseInt(nextEl.value || '1', 10);
                const invalid = Number.isNaN(next) || next < 1;

                if (invalid) {
                    nextEl.classList.add('is-invalid');
                    nextEl.setCustomValidity('invalid');
                    return null;
                }

                nextEl.classList.remove('is-invalid');
                nextEl.setCustomValidity('');

                return next;
            }

            function buildPreview() {
                const prefix = (prefixEl.value || '').trim();

                let digits;
                let next;
                
                if (!isEnabled()) {
                    digits = parseInt(digitsEl.value || '4', 10);
                    if (Number.isNaN(digits) || digits < 1) digits = 4;

                    next = parseInt(nextEl.value || '1', 10);
                    if (Number.isNaN(next) || next < 1) next =1;
          
                    setInnerDisabled(true);      
                } else {
                    setInnerDisabled(false);

                    digits = validateDigits();
                    if (digits === null) {
                        previewEl.value = '';
                        return;
                    }

                    next = validateNext();
                    if (next === null) {
                        previewEl.value = '';
                        return;
                    }

                }

                const numeric = padLeft(next, digits);
                previewEl.value = prefix ? (prefix + '-' + numeric) : numeric;
            }

            enabledEl.addEventListener('change', buildPreview);

            [prefixEl, digitsEl, nextEl].forEach(el => {
                ['input','change'].forEach(evt => el.addEventListener(evt, buildPreview));
            });

            form.addEventListener('submit', function(e) {

                buildPreview();

                if (isEnabled() && !form.checkValidity()) {

                    e.preventDefault();
                    e.stopPropagation();
                }

                form.classList.add('was-validated');
            });
            
            buildPreview();
        })();
    </script>
}