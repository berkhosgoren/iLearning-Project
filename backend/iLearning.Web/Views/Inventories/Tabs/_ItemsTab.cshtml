@model iLearning.Web.Models.ViewModels.Inventories.InventoryDetailsVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    var msg = TempData["InventoryMessage"] as string;
    var selectedPrefixJson = System.Text.Json.JsonSerializer.Serialize(T["Common.SelectedPrefix"].Value);
}

@if (!string.IsNullOrWhiteSpace(msg))
{
    <div class="alert alert-success mb-3">@msg</div>
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="text-muted small">
        @T["Inv.Items.Count", Model.Items.Count]
        @if (!Model.CanWrite)
        {
            <span class="m-sm-2">@T["Inv.Items.ReadOnly"]</span>
        }
    </div>

    @if (Model.CanWrite)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-primary btn-sm" asp-controller="Items" asp-action="Create" asp-route-inventoryId="@Model.Id">
                @T["Inv.Items.Add"]
            </a>

            <form method="post" asp-controller="Items" asp-action="BulkDelete" asp-route-inventoryId="@Model.Id" id="itemsDeleteForm">
                @Html.AntiForgeryToken()
                <button class="btn btn-danger btn-sm" type="submit" id="itemsDeleteBtn" disabled>
                    @T["Inv.Items.DeleteSelected"]
                </button>
            </form>
        </div>
    }
</div>

<div class="table-responsive">
    <table class="table table-sm align-middle mb-0">
        <thead class="table table-hover">
            <tr>
                <th style="width:44px;" class="text-center align-middle p-0">
                    @if (Model.CanWrite)
                    {
                        <input type="checkbox" id="itemsAll" class="form-check-input d-block mx-auto my-2" aria-label="@T["Common.SelectAll"]" />
                    }
                </th>
                <th style="width:160px;">@T["Inv.Items.Th.CustomId"]</th>
                <th>@T["Inv.Items.Th.Title"]</th>
                <th style="width:120px;">@T["Inv.Items.Th.Likes"]</th>
                <th style="width:120px;">@T["Inv.Items.Th.Comments"]</th>
                <th style="width:170px;">@T["Inv.Items.Th.Created"]</th>
                <th style="width:170px;">@T["Inv.Items.Th.Updated"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-muted text-center py-4">@T["Inv.Items.None"]</td>
                </tr>
            }
            else
            {
                @foreach (var it in Model.Items)
                {
                    <tr>
                        <td class="text-center align-middle p-0">
                            @if (Model.CanWrite)
                            {
                                <input type="checkbox" class="form-check-input d-block mx-auto my-2 itemRow" name="ids" value="@it.Id" form="itemsDeleteForm" />
                            }
                        </td>
                        <td>
                            <a class="text-decoration-none" asp-controller="Items" asp-action="Details" asp-route-inventoryId="@Model.Id" asp-route-itemId="@it.Id">
                                @it.CustomId
                            </a>
                        </td>
                        <td>@it.Title</td>
                        <td>@it.LikesCount</td>
                        <td>@it.CommentsCount</td>
                        <td>@it.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (it.UpdatedAtUtc.HasValue)
                            {
                                @it.UpdatedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.CanWrite)
{
    <div class="text-muted small mt-2" id="itemsSelectedLabel">@T["Common.SelectedPrefix"]0</div>
}
<script>
    (function () {
        const all = document.getElementById('itemsAll');
        const label = document.getElementById('itemsSelectedLabel');
        const delBtn = document.getElementById('itemsDeleteBtn');

        const rows = () => Array.from(document.querySelectorAll('input.itemRow'));
        const selectedPrefix = @Html.Raw(selectedPrefixJson);

        function setDeleteEnabled(enabled) {
            if (delBtn) delBtn.disabled = !enabled;
        }

        function update() {
            const rowCbs = rows();
            const checkedCount = rowCbs.filter(x => x.checked).length;

            if (label) label.textContent = selectedPrefix + checkedCount;
            setDeleteEnabled(checkedCount > 0);

            if (!all) return;

            const totalCount = rowCbs.length;

            if (totalCount === 0) {
                all.checked = false;
                all.indeterminate = false;
            } else if (checkedCount === 0) {
                all.checked = false;
                all.indeterminate = false;
            } else if (checkedCount === totalCount) {
                all.checked = true;
                all.indeterminate = false;
            } else {
                all.checked = false;
                all.indeterminate = true;
            }
        }

        all?.addEventListener('change', function() {
            rows().forEach(x => x.checked = all.checked);
            update();
        });

        document.addEventListener('change', function (e) {
            if (e.target && e.target.matches('input.itemRow')) {
                update();
            }
        });

        update();
    })();
</script>
