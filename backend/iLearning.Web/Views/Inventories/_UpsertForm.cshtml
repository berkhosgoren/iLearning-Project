@model iLearning.Web.Models.ViewModels.Inventories.InventoryUpsertVm
@using iLearning.Web.Models.Domain
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    var categories = ViewBag.Categories as List<Category> ?? new();
}

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ImageFile" class="form-label"></label>
    <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" data-autosave-ignore-field="true" />
    <div class="form-text">@T["Inv.Form.ImageUploadHint"]</div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
{
    <div class="mb-3">
        <div class="form-text mb-2">@T["Inv.Form.CurrentImage"]</div>
        <img src ="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded border" style="max-height: 240px;" />
    </div>
}

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select">
            @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="col-md-6 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="IsPublic" class="form-check-input" />
            <label asp-for="IsPublic" class="form-check-label"></label>
            <div class="form-text">@T["Inv.Form.PublicHint"]</div>
        </div>
    </div>
</div>

<hr class="my-4" />

<div class="mb-3 position-relative">
    <label asp-for="TagsCsv" class="form-label"></label>

    <input asp-for="TagsCsv" class="form-control" autocomplete="off" id="tagsInput" />
    <div class="form-text">@T["Inv.Form.TagsHint"]</div>
    <span asp-validation-for="TagsCsv" class="text-danger"></span>

    <div class="list-group position-absolute w-100 shadow-sm d-none" id="tagsSuggest" style="z-index: 1050; max-height: 240px; overflow:auto"></div>
</div>

<script>
    (function () {
        const input = document.getElementById('tagsInput');
        const box = document.getElementById('tagsSuggest');
        if (!input || !box) return;

        let timer = null;
        let lastQuery = '';

        function normalize(s) { return (s || '').trim().toLowerCase(); }

        function parseTags(csv) {
            return (csv || '')
            .split(',')
            .map(x => x.trim())
            .filter(x => x.length > 0);
        }

        function currentToken() {
            const v = input.value || '';
            const parts = v.split(',');
            return (parts[parts.length - 1] || '').trim();
        }

        function hide() {
            box.classList.add('d-none');
            box.innerHTML = '';
        }

        function show(items) {
            box.innerHTML = '';
            items.forEach(it => {
                const a = document.createElement('button');
                a.type = 'button';
                a.className = 'list-group-item list-group-item-action';
                a.textContent = it.name;
                a.addEventListener('click', () => insertTag(it.name));
                box.appendChild(a);
            });
            if (items.length > 0) box.classList.remove('d-none');
            else hide();
        }

        function insertTag(tagName) {
            const existing = parseTags(input.value);
            const exists = existing.some(t => normalize(t) === normalize(tagName));
            if (exists) {
                replaceLastToken(existing.join(', '));
                hide();
                return;
            }

            const updated = existing.slice();
            if (updated.length === 0) updated.push(tagName);
            else {
                const token = currentToken();
                if (token.length > 0) updated.pop();
                updated.push(tagName);
            }

            replaceLastToken(updated.join(', ') + ', ');
            hide();
            input.focus();
        }

        function replaceLastToken(newValue) {
            input.value = newValue;
        }

        async function fetchSuggest(q) {
            const res = await fetch('/tags/suggest?q=' + encodeURIComponent(q), {
                headers: { 'Accept': 'application/json' }
            });
            if (!res.ok) return[];
            const data = await res.json();
            return (data || []).map(x => ({ id: x.id, name: x.name }));
        }

        async function update() {
            const token = currentToken();
            if (token.length < 2) { hide(); return; }
            if (token === lastQuery) return;
            lastQuery = token;

            const items = await fetchSuggest(token);

            const selected = parseTags(input.value).map(normalize);
            const filtered = items.filter(x => !selected.includes(normalize(x.name)));

            show(filtered);
        }

        input.addEventListener('input', () => {
            if (timer)clearTimeout(timer);
            timer = setTimeout(update, 200);
        });

        input.addEventListener('blur', () => {
            setTimeout(hide, 150);
        });

        input.addEventListener('focus', () => {
            if (currentToken().trim().length >= 2) update();
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') hide();
        }); 
    })();
</script>

