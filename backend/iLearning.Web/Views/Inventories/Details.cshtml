@model iLearning.Web.Models.ViewModels.Inventories.InventoryDetailsVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = Model.Title;
    var tab = (Model.ActiveTab ?? "items").ToLowerInvariant();

    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isStatsPage = string.Equals(controller, "InventoryStats", StringComparison.OrdinalIgnoreCase);
    var isFieldsPage = string.Equals(controller, "InventoryFields", StringComparison.OrdinalIgnoreCase);
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div>
            <h2 class="mb-1">@Model.Title</h2>
            <div class="text-muted">
                @Model.CategoryName · @T["InvDetails.By"] @Model.CreatorName
                @if (Model.IsPublic)
                {
                    <span class="badge text-bg-success ms-2">@T["InvDetails.Public"]</span>
                }
                else
                {
                    <span class="badge text-bg-secondary ms-2">@T["InvDetails.Private"]</span>
                }
            </div>

            @if (Model.Tags.Count > 0)
            {
                <div class="mt-2 d-flex flex-wrap gap-2">
                    @foreach (var t in Model.Tags)
                    {
                        <span class="badge bg-body-secondary text-body border">@t</span>
                    }
                </div>

            }
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">@T["Common.Back"]</a>

            @if (Model.CanEdit)
            {
                <a class="btn btn-outline-primary" asp-controller="Inventories" asp-action="Edit" asp-route-id="@Model.Id">
                    @T["InvDetails.EditInventory"]
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.DescriptionHtml) || !string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="card mt-3">
            <div class="card-body">
                <div class="text-muted small mb-2">Description</div>

                @if (!string.IsNullOrWhiteSpace(Model.DescriptionHtml))
                {
                    <div class="mt-2 markdown-body">
                        @Html.Raw(Model.DescriptionHtml)
                    </div>
                }
                else
                {
                    <div class="text-muted mt-2">
                        @Model.Description
                    </div>
                }
            </div>
        </div>
    }

    <ul class="nav nav-tabs mt-4">
        <li class="nav-item">
            <a class="nav-link @(tab=="items" ? "active" : "")"
               asp-controller="Inventories" asp-action="Details" asp-route-id="@Model.Id" asp-route-tab="items">@T["InvTabs.Items"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(tab=="discussion" ? "active" : "")"
               asp-controller="Inventories" asp-action="Details" asp-route-id="@Model.Id" asp-route-tab="discussion">@T["InvTabs.Discussion"]</a>
        </li>

        @* Edit-only tabs: owner/admin*@
        @if (Model.CanEdit)
        {
            <li class="nav-item">
                <a class="nav-link @(tab == "settings" ? "active" : "")"
                   asp-controller="Inventories" asp-action="Details" asp-route-id="@Model.Id" asp-route-tab="settings">@T["InvTabs.Settings"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tab == "customid" ? "active" : "")"
                   asp-controller="Inventories" asp-action="Details" asp-route-id="@Model.Id" asp-route-tab="customid">@T["InvTabs.CustomId"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(isFieldsPage ? "active" : "")"
                   asp-controller="InventoryFields" asp-action="Index" asp-route-inventoryId="@Model.Id">@T["InvTabs.Fields"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tab == "access" ? "active" : "")"
                   asp-controller="Inventories" asp-action="Details" asp-route-id="@Model.Id" asp-route-tab="access">@T["InvTabs.Access"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(isStatsPage ? "active" : "")"
                   asp-controller="InventoryStats" asp-action="Index" asp-route-inventoryId="@Model.Id">@T["InvTabs.Stats"]</a>
            </li>
        }
       
        <li class="nav-item ms-auto">
            <span class="nav-link disabled">Auto-save: (for later)</span>
        </li>
     </ul>

     <div class="card border-top-0 rounded-top-0">
         <div class="card-body">
                @if (tab == "items")
                {
                    <partial name="Tabs/_ItemsTab" model="Model" />
                }
                else if (tab == "discussion")
                {
                    <partial name="Tabs/_DiscussionTab" model="Model" />
                }
                else if (tab == "settings")
                {
                    <partial name="Tabs/_SettingsTab" model="Model" />
                }
                else if (tab == "customid")
                {
                    <partial name="Tabs/_CustomIdTab" model="Model" />
                }
                else if (tab == "fields")
                {
                    <partial name="Tabs/_FieldsTab" model="Model" />
                }
                else if (tab == "access")
                {
                    <partial name="Tabs/_AccessTab" model="Model" />
                }
                else
                {
                <div class="text-muted">@T["InvTabs.UnknownTab"]</div>
                }
           </div>
        </div>
</div>