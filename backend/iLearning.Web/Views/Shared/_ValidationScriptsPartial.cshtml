@using System.Globalization;
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

<script>
    (function () {
        if (!window.jQuery || !jQuery.validator) return;

        jQuery.validator.methods.number = function (value, element) {
            if (this.optional(element)) {
                return true;
            }

            return /^-?\d+(?:[.,]\d+)?$/.test((value || '').trim());
        };

        jQuery.validator.messages.required = `@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(T["Validation.Required"].Value))`;
        jQuery.validator.messages.number = `@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(T["Validation.Number"].Value))`;
        jQuery.validator.messages.maxlength = jQuery.validator.format(`@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(T["Validation.MaxLength"].Value))`);
    })();
</script>