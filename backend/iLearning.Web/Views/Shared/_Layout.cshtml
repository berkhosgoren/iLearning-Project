@using System.Globalization;
@using iLearning.Web;

@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    var theme = (Context.Request.Cookies["ilearning_theme"] ?? "light").Trim().ToLowerInvariant();
    if (theme != "dark" && theme != "light") { theme = "light"; }

    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    var routeController = ViewContext.RouteData.Values["controller"]?.ToString();
    Guid? currentInventoryId = null;

    if (string.Equals(routeController, "Inventories", StringComparison.OrdinalIgnoreCase) &&
        Guid.TryParse(ViewContext.RouteData.Values["id"]?.ToString(), out var invIdFromId))
    {
        currentInventoryId = invIdFromId;
    }
    else if (Guid.TryParse(ViewContext.RouteData.Values["inventoryId"]?.ToString(), out var invIdFromRoute))
    {
        currentInventoryId = invIdFromRoute;
    }

    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var isSupportPage = currentPath.StartsWith("/support", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="@lang" data-bs-theme="@theme">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - iLearning.Web</title>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </head>
    <body>
        <header class="border-bottom bg-body">
            <nav class="navbar navbar-expand-lg bg-body-tertiary">
                <div class="container">
                    <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">@T["App.Title"]</a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav"
                            aria-controls="topNav" aria-expanded="false" aria-label="@T["Nav.ToggleNavigationAria"]">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse gap-3" id="topNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">@T["Nav.Home"]</a>
                            </li>
                        </ul>

                        <form class="d-flex flex-grow-1" method="get" asp-controller="Search" asp-action="Index" role="search">
                        <input class="form-control me-2" name="q" type="search" placeholder="@T["Nav.SearchPlaceholder"]"
                                    value="@Context.Request.Query["q"]" aria-label="@T["Nav.SearchAria"]">
                        <button class="btn btn-outline-primary" type="submit">@T["Nav.SearchButton"]</button>
                        </form>

                        <div class="d-flex align-items-center gap-2 ms-5">
                        @if (User?.Identity?.IsAuthenticated == true)
                            {
                                <a class="btn btn-success" asp-controller="Inventories" asp-action="Create">
                                @T["Nav.CreateInventory"]
                                </a>

                                <div class="dropdown">
                                    <button class="btn btn-secondary dropdown-toggle" type="button" 
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                            @User.Identity!.Name
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end" style="min-width: 16rem;">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Index">
                                                @T["Nav.Profile"]
                                            </a>
                                        </li>                                        

                                        <li>
                                            <form method="post" action="/prefs/theme" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <input type="hidden" name="theme" value="@(theme == "dark" ? "light" : "dark")" />
                                                @{
                                                        var nextTheme = theme == "dark" ? "light" : "dark";
                                                        var nextThemeLabel = nextTheme == "dark" ? T["Theme.Dark"] : T["Theme.Light"];
                                                 }
                                                <button class="dropdown-item" type="submit">
                                                @(theme == "dark" ? $"☀️ {string.Format(T["Nav.ThemeToggle"], nextThemeLabel)}" 
                                                                  : $"🌙 {string.Format(T["Nav.ThemeToggle"], nextThemeLabel)}")
                                                </button>
                                            </form>
                                        </li>

                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">@T["Nav.Language"]</h6></li>
                                        <li>
                                            <form method="post" action="/prefs/language" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <input type="hidden" name="culture" value="en" />
                                                <button type="submit" class="dropdown-item @(lang == "en" ? "active" : "")">
                                                    English (EN)
                                                </button>
                                           </form>
                                        </li>

                                        <li>
                                            <form method="post" action="/prefs/language" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <input type="hidden" name="culture" value="ru" />
                                                <button type="submit"class="dropdown-item @(lang == "ru" ? "active" : "")">
                                                    Русский (RU)
                                                </button>
                                            </form>
                                        </li>
                                            
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item" href="/admin/users">
                                                @T["Nav.AdminPanel"]
                                                </a>
                                            </li>
                                        }

                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form method="post" action="/auth/logout" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button class="dropdown-item text-danger" type="submit">
                                                @T["Nav.Logout"]
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <form method="post" action="/prefs/theme" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <input type="hidden" name="theme" value="@(theme == "dark" ? "light" : "dark")" />
                                    <button class="btn btn-outline-secondary px-2" type="submit" title="@T["Nav.ToggleThemeTitle"]">
                                        @(theme == "dark" ? "☀️" : "🌙")
                                    </button>
                                </form>

                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary px-2" type="button"
                                            data-bs-toggle="dropdown" aria-expanded="false"
                                            title="@T["Nav.Language"]">
                                        @lang.ToUpperInvariant()
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <form method="post" action="/prefs/language" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <input type="hidden" name="culture" value="en" />
                                                <button type="submit" class="dropdown-item @(lang == "en" ? "active" : "")">
                                                    EN
                                                </button>
                                            </form>
                                        </li>
                                        <li>
                                            <form method="post" action="/prefs/language" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <input type="hidden" name="culture" value="ru" />
                                                <button type="submit" class="dropdown-item @(lang == "ru" ? "active" : "")">
                                                    RU
                                                </button>
                                             </form>
                                        </li>
                                    </ul>
                                </div>

                            <a class="btn btn-outline-secondary" asp-controller="Auth" asp-action="Login">@T["Nav.Login"]</a>
                            <a class="btn btn-primary" asp-controller="Auth" asp-action="Register">@T["Nav.Register"]</a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="border-top mt-4 py-3 bg-body-tertiary">
            <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="text-muted small">@T["App.Title"]</div>

                @if (User?.Identity?.IsAuthenticated == true && !isSupportPage)
                {
                   <div class="d-flex align-items-center gap-2">
                       <span class="text-muted small">@T["Support.FooterPrompt"]</span>
                       <a class="btn btn-outline-primary btn-sm" asp-controller="SupportTickets" asp-action="Create"
                          asp-route-returnUrl="@returnUrl" asp-route-inventoryId="@(currentInventoryId.ToString())">
                          @T["Support.FooterLink"]
                       </a>
                   </div>
                }
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        @RenderSection("Scripts", required: false)
    </body>
</html>