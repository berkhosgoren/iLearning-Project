@model iLearning.Web.Models.ViewModels.Support.SupportTicketVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["Support.PageTitle"];
}

<div class="container py-4" style="max-width: 860px;">
    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h2 class="mb-1">@T["Support.Heading"]</h2>
            <div class="text-muted small">@T["Support.Help"]</div>
        </div>

        <a class="btn btn-outline-secondary" href="@Model.ReturnUrl">@T["Common.Back"]</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="ReturnUrl" type="hidden" />
                <input asp-for="InventoryId" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Summary" class="form-label"></label>
                    <input asp-for="Summary" class="form-control" />
                    <span asp-validation-for="Summary" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Priority" class="form-label"></label>
                    <select asp-for="Priority" class="form-select">
                        <option value="High">@T["Support.Priority.High"]</option>
                        <option value="Average">@T["Support.Priority.Average"]</option>
                        <option value="Low">@T["Support.Priority.Low"]</option>
                    </select>
                    <span asp-validation-for="Priority" class="text-danger"></span>
                </div>

                <hr />

                <div class="mb-3">
                    <label class="form-label">@T["Support.ReportedBy"]</label>
                    <input class="form-control" value="@Model.ReportedByName" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">@T["Support.ReportedByEmail"]</label>
                    <input class="form-control" value="@Model.ReportedByEmail" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">@T["Support.Inventory"]</label>
                    <input class="form-control" value="@(string.IsNullOrWhiteSpace(Model.InventoryTitle) ? T["Common.NotApplicable"].Value : Model.InventoryTitle)" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">@T["Support.Link"]</label>
                    <input class="form-control" value="@Model.CurrentPageUrl" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">@T["Support.AdminEmails"]</label>
                    <textarea class="form-control" rows="2" readonly>@Model.AdminEmailCsv</textarea>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">@T["Support.Submit"]</button>
                    <a class="btn btn-outline-secondary" href="@Model.ReturnUrl">@T["Common.Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}