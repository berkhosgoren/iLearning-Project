@model List<iLearning.Web.Models.ViewModels.Home.HomeInventoryCardVm>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["Home.PublicInventories.Title"];
}

<div class="container mt-4">
    <h3 class="mb-4">@T["Home.PublicInventories.Heading"]</h3>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary">
            @T["Home.PublicInventories.Empty"]
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach ( var inv in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(inv.ImageUrl))
                        {
                            <img src="@inv.ImageUrl" class="card-img-top" />
                        }

                        <div class="card-body">

                            <h5 class="card-title">
                                @inv.Title
                            </h5>

                            <p class="text-muted small mb-2">
                                @inv.CategoryName • @T["Common.By"] @inv.CreatorName
                            </p>

                            <p class="text-muted small mb-2">
                                @T["Common.CreatedLabel"] @inv.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </p>

                            <div class="markdown-preview text-muted small">
                                @Html.Raw(inv.DescriptionHtml)
                            </div>

                        </div>

                        <div class="card-footer bg-body border-0">
                            <a class="btn btn-outline-primary btn-sm w-100"
                            asp-controller="Inventories"
                            asp-action="Details"
                            asp-route-id="@inv.Id">
                                @T["Home.PublicInventories.ViewInventory"]
                            </a>
                        </div>

                    </div>
                </div>
            }

        </div>
        }

</div>