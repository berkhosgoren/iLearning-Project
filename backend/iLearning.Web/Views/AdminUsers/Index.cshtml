@model iLearning.Web.Models.ViewModels.Admin.AdminUsersIndexVm
@using iLearning.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["Nav.AdminPanel"];
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h2 class="mb-0">@T["Admin.Users.Title"]</h2>
        </div>  
        
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-info">@Model.Message</div>
        }

    <div class="card">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="fw-semibold">@T["Admin.Users.CardTitle"]</div>

            <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
                <input class="form-control form-control-sm" style="width: 280px"
                       name="q" value="@Model.Q" placeholder="@T["Admin.Users.FilterPlaceholder"]" />
                
                <select class="form-select form-select-sm" name="s" style="width: 160px">
                    <option value="created" selected="@(Model.Sort == "created")">@T["Admin.Users.Sort.Created"]</option>
                    <option value="name" selected="@(Model.Sort == "name")">@T["Admin.Users.Sort.Name"]</option>
                    <option value="email" selected="@(Model.Sort == "email")">@T["Admin.Users.Sort.Email"]</option>
                    <option value="blocked" selected="@(Model.Sort == "blocked")">@T["Admin.Users.Sort.Blocked"]</option>
                </select>

                <select class="form-select form-select-sm" name="d" style="width: 120px">
                    <option value="desc" selected="@(Model.Dir == "desc")">@T["Admin.Users.Dir.Desc"]</option>
                    <option value="asc" selected="@(Model.Dir == "asc")">@T["Admin.Users.Dir.Asc"]</option>
                </select>

                <button class="btn btn-outline-secondary btn-sm" type="submit">@T["Admin.Users.Apply"]</button>
            </form>
        </div>

        <div class="card-body">
            <form method="post" asp-action="Bulk" asp-controller="AdminUsers" id="bulkForm">
                @Html.AntiForgeryToken()

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <div class="text-muted small" id="selLabel">@T["Admin.Users.Selected"]</div>

                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-warning btn-sm" type="submit" name="cmd" value="block" id="blockBtn" disabled>@T["Admin.Users.Block"]</button>
                        <button class="btn btn-success btn-sm" type="submit" name="cmd" value="unblock" id="unblockBtn" disabled>@T["Admin.Users.Unblock"]</button>
                        <button class="btn btn-outline-primary btn-sm" type="submit" name="cmd" value="toggle-admin" id="toggleAdminBtn" disabled>@T["Admin.Users.ToggleAdmin"]</button>
                        <button class="btn btn-danger btn-sm" type="submit" name="cmd" value="delete" id="deleteBtn" disabled>@T["Admin.Users.Delete"]</button>
                    </div>
                </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table table-hover">
                        <tr>
                            <th style="width:44px;" class="text-center align-middle p-0">
                                <input type="checkbox" id="all" class="form-check-input d-block mx-auto my-2" aria-label="@T["Common.SelectAllAria"]" />
                            </th>
                                <th>@T["Admin.Users.Col.Name"]</th>
                                <th style="width:260px;">@T["Admin.Users.Col.Email"]</th>
                                <th style="width:120px;">@T["Admin.Users.Col.Blocked"]</th>
                                <th style="width:120px;">@T["Admin.Users.Col.Admin"]</th>
                                <th style="width:140px;">@T["Admin.Users.Col.Owned"]</th>
                                <th style="width:170px;">@T["Admin.Users.Col.Created"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users.Count == 0)
                        {
                            <tr>
                                    <td colspan="7" class="text-muted text-center py-4">@T["Admin.Users.NoneFound"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var u in Model.Users)
                            {
                                <tr>
                                    <td class="text-center align-middle p-0">
                                        <input type="checkbox" class="form-check-input d-block mx-auto my-2 row" name="ids" value="@u.Id" />    
                                    </td>
                                    <td>@u.Name</td>
                                    <td>@u.Email</td>
                                    <td>
                                        @if (u.IsBlocked)
                                        {
                                                <span class="badge text-bg-warning">@T["Admin.Users.Yes"]</span>
                                        }
                                        else
                                        {
                                                <span class="badge text-bg-secondary">@T["Admin.Users.No"]</span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.IsAdmin)
                                        {
                                                <span class="badge text-bg-primary">@T["Admin.Users.Role.Admin"]</span>
                                        }
                                        else
                                        {
                                                <span class="badge bg-body-secondary text-body border">@T["Admin.Users.Role.User"]</span>
                                        }
                                    </td>
                                    <td>@u.OwnedInventoriesCount</td>
                                    <td>@u.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @using System.Text.Json

    <script>
        (function () {
            const all = document.getElementById('all');
            const label = document.getElementById('selLabel');

            const blockBtn = document.getElementById('blockBtn');
            const unblockBtn = document.getElementById('unblockBtn');
            const toggleAdminBtn = document.getElementById('toggleAdminBtn');
            const deleteBtn = document.getElementById('deleteBtn');

            const rows = () => Array.from(document.querySelectorAll('input.row'));

            const selectedTemplate = @Html.Raw(JsonSerializer.Serialize(T["Admin.Users.Selected", "__COUNT__"].Value));

            function setButtonsEnabled(enabled) {
                blockBtn.disabled = !enabled;
                unblockBtn.disabled = !enabled;
                toggleAdminBtn.disabled = !enabled;
                deleteBtn.disabled = !enabled;
            }

            function update() {
                const rowCbs = rows();
                const checkedCount = rowCbs.filter(x => x.checked).length;

                label.textContent = selectedTemplate.replace('__COUNT__', checkedCount);

                setButtonsEnabled(checkedCount > 0);

                const totalCount = rowCbs.length;

                if (totalCount === 0) {
                    all.checked = false;
                    all.indeterminate = false;
                } else if (checkedCount === 0) {
                    all.checked = false;
                    all.indeterminate=false;
                } else if (checkedCount === totalCount) {
                    all.checked = true;
                    all.indeterminate = false;
                } else {
                    all.checked = false;
                    all.indeterminate = true;
                }
            }
            
            all?.addEventListener('change', function () {
                rows().forEach(x => x.checked = all.checked);
                update();
            });

            document.addEventListener('change', function(e) {
                if (e.target && e.target.matches('input.row')) {
                    update();
                }
            });

            update();
        })();
    </script>
}