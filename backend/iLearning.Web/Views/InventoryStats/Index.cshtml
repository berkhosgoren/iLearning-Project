@model iLearning.Web.Models.ViewModels.Inventories.InventoryStatsPageVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = string.Format(T["InventoryStats.PageTitleFormat"], Model.InventoryTitle);
    var odooToken = TempData["OdooApiToken"] as string;
    var statsMessage = TempData["StatsMessage"] as string;
}

<div class="container py-4">

    @if (!string.IsNullOrWhiteSpace(statsMessage))
    {
        <div class="alert alert-success mb-3">@statsMessage</div>
    }

    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-1">@Model.InventoryTitle</h2>
            <div class="text-muted small">
                @T["InventoryStats.InventoryStats"]
                @if (Model.IsPublic)
                {
                    <span class="badge text-bg-success ms-2">@T["Common.Public"]</span>
                }
                else
                {
                    <span class="badge text-bg-secondary ms-2">@T["Common.Private"]</span>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-controller="InventoryStats" asp-action="ExportCsv" asp-route-inventoryId="@Model.InventoryId">
                @T["InventoryStats.ExportCsv"]
            </a>

            <a class="btn btn-outline-secondary" asp-controller="Inventories" asp-action="Details" 
               asp-route-id="@Model.InventoryId" asp-route-tab="Items">
                @T["Common.BackToInventory"]
            </a>
        </div>
    </div>

    
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="fw-semibold">@T["Odoo.Token.SectionTitle"]</div>
                    <div class="text-muted small">@T["Odoo.Token.Help"]</div>

                    @if (Model.HasOdooApiToken && Model.OdooApiTokenGeneratedAtUtc.HasValue)
                    {
                        <div class="text-muted small mt-2">
                            @T["Odoo.Token.GeneratedAt"] @Model.OdooApiTokenGeneratedAtUtc.Value.ToString("dd-MM-yyyy HH:mm:ss 'UTC'")
                        </div>
                    }
                </div>

                <form method="post" asp-controller="Odoo" asp-action="GenerateToken" asp-route-inventoryId="@Model.InventoryId" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm">
                        @(Model.HasOdooApiToken? T["Odoo.Token.Regenerate"] : T["Odoo.Token.Generate"])
                    </button>
                </form>
            </div>

            @if (!string.IsNullOrWhiteSpace(odooToken))
            {
                <div class="mt-3">
                    <label class="form-label">@T["Odoo.Token.Value"]</label>
                    <input class="form-control" value="@odooToken" readonly />

                    <div class="form-text mt-2">
                        @T["Odoo.Token.CopyHint"]
                    </div>

                    <div class="mt-2">
                        <label class="form-label">@T["Odoo.Token.Url"]</label>
                        <input class="form-control"
                               value="@($"{Context.Request.Scheme}://{Context.Request.Host}/integrations/odoo/inventory?token={odooToken}")" readonly />
                    </div>
                </div>
            }
        </div>
    </div>

    <partial name="_StatsPanel" model="Model" />
</div>