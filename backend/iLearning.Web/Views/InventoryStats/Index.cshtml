@model iLearning.Web.Models.ViewModels.Inventories.InventoryStatsPageVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = string.Format(T["InventoryStats.PageTitleFormat"], Model.InventoryTitle);
}

<div class="container py-4">
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-1">@Model.InventoryTitle</h2>
            <div class="text-muted small">
                @T["InventoryStats.InventoryStats"]
                @if (Model.IsPublic)
                {
                    <span class="badge text-bg-success ms-2">@T["Common.Public"]</span>
                }
                else
                {
                    <span class="bade text-bg-secondary ms-2">@T["Common.Private"]</span>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-controller="Inventories" asp-action="Details" 
               asp-route-id="@Model.InventoryId" asp-route-tab="Items">
                @T["Common.BackToInventory"]
            </a>
        </div>
    </div>

    <partial name="_StatsPanel" model="Model" />
</div>